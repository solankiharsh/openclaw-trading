# API Configuration (backend must be running and reachable for login to work)
# Local: backend default port is 3001 — run backend then set below or leave unset
# Production: use your Railway backend URL (e.g. https://web-production-564c3.up.railway.app)
NEXT_PUBLIC_API_URL=https://web-production-564c3.up.railway.app
NEXT_PUBLIC_WS_URL=wss://web-production-564c3.up.railway.app

# Feature Flags (optional)
# NEXT_PUBLIC_ENABLE_DASHBOARD=true  # Enable Agent Command Center (/dashboard) - currently disabled by default

# Privy Authentication (REQUIRED - primary auth method)
# Supports: Email, Twitter OAuth, Wallet
# Get your App ID from: https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=cmlndnhus01bu0blekl81c6ay

# Optional: OpenClaw demo video (upload via: make upload-video-supabase, then set URL here)
# NEXT_PUBLIC_OPENCLAW_VIDEO_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/assets/videos/OpenClaw_Trading.mp4
